# SnapFind Events — copy to .env (backend) and .env.local (frontend) as needed.
# Never commit a filled-in .env.

# Frontend: backend base URL. Empty = same-origin (single-container deploy).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend: Postgres URL (e.g. Neon). Without it, local SQLite snapfind-events.db.
DATABASE_URL=

# Secrets — generate real values for deploy; never reuse SnapFind's.
SECRET_KEY=change-me
JWT_SECRET=change-me

# First admin account, auto-created on startup if it doesn't exist.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=change-me

# Cloudinary (unsigned upload preset — no API secret in code).
# Event photos & guest selfies live here permanently.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=snapfind-events

# Public URLs used in join links / QR codes.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=

# Max upload size per request (MB).
MAX_UPLOAD_MB=100
